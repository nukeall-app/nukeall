{
  "name": "nukeall-monorepo",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:ext": "npm run dev -w apps/extension",
    "dev:web": "npm run dev -w apps/website",
    "build": "npm run build -w apps/extension && npm run build:firefox -w apps/extension && npm run build -w apps/website",
    "test": "npm test -w apps/extension",
    "typecheck": "npm run typecheck -w apps/extension",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
