---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/routes';

const en = t('en').notFound;
const tr = t('tr').notFound;
---
<Base lang="en" page="notFound">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="text-6xl font-black text-orange-500">404</div>
    <h1 class="text-2xl font-bold text-white">{en.h1}</h1>
    <p class="text-sm text-zinc-400">{en.body}</p>
    <p class="text-sm text-zinc-500">{tr.h1}</p>
    <div class="flex justify-center gap-3 pt-2">
      <a href="/" class="px-4 py-2 rounded-lg bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400">
        {en.home}
      </a>
      <a href="/tr/" class="px-4 py-2 rounded-lg border border-zinc-700 text-white font-semibold text-sm hover:border-orange-500">
        {tr.home}
      </a>
    </div>
  </div>
</Base>
