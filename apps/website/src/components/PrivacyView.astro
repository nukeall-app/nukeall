---
import { t, type Lang } from '../i18n/routes';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<div class="max-w-3xl mx-auto px-4 py-16 space-y-10">
  <header class="space-y-2">
    <h1 class="text-4xl font-extrabold text-white tracking-tight">{d.privacyPage.h1}</h1>
    <p class="text-xs text-zinc-500">{d.privacyPage.updated}</p>
  </header>

  <div class="space-y-8">
    {d.privacyPage.sections.map((sec) => (
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">{sec.title}</h2>
        {sec.body.map((p) => (
          <p class="text-sm text-zinc-300 leading-relaxed">{p}</p>
        ))}
      </section>
    ))}
  </div>
</div>
