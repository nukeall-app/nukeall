---
import { REPO_URL } from '../config';
import { GUIDE_KEYS, guides, type GuideKey } from '../data/guides';
import { path, t, type Lang } from '../i18n/routes';

export interface Props {
  lang: Lang;
  guideKey: GuideKey;
}

const { lang, guideKey } = Astro.props;
const d = t(lang);
const g = guides[guideKey][lang];
const installUrl = path('install', lang);
const otherGuides = GUIDE_KEYS.filter((k) => k !== guideKey);
---

<section class="border-b border-zinc-800/80">
  <div class="max-w-4xl mx-auto px-4 py-14 md:py-20 space-y-6">
    <div class="text-xs text-zinc-400">
      <a href={path('home', lang)} class="hover:text-white">{d.nav.home}</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-300">{g.navLabel}</span>
    </div>

    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-orange-500/10 text-orange-400 border border-orange-500/30">
      {g.eyebrow}
    </span>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
      {g.h1}
    </h1>

    <p class="text-base sm:text-lg text-zinc-300 leading-relaxed max-w-3xl">
      {g.lead}
    </p>

    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a
        href={installUrl}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400 transition-colors"
      >
        {d.nav.install}
      </a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-zinc-700 bg-zinc-900 text-white font-semibold text-sm hover:border-orange-500 transition-colors"
      >
        ★ {d.hero.ctaGithub}
      </a>
    </div>
  </div>
</section>

<section class="max-w-4xl mx-auto px-4 py-12 space-y-12">
  <div class="grid gap-4 md:grid-cols-3">
    {g.highlights.map((h) => (
      <article class="p-5 rounded-2xl border border-zinc-800 bg-zinc-900/50 space-y-2">
        <h2 class="font-bold text-white text-base">{h.title}</h2>
        <p class="text-sm text-zinc-400 leading-relaxed">{h.body}</p>
      </article>
    ))}
  </div>

  <div class="space-y-6">
    <h2 class="text-2xl font-bold text-white tracking-tight">{g.stepsTitle}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {g.steps.map((s, idx) => (
        <div id={`step-${idx + 1}`} class="p-5 rounded-2xl border border-zinc-800 bg-zinc-950 space-y-2.5">
          <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-orange-500/15 text-orange-400 font-bold text-xs border border-orange-500/30">
            {idx + 1}
          </div>
          <h3 class="font-bold text-white text-base">{s.title}</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
  </div>

  <aside class="p-6 rounded-2xl border border-orange-500/30 bg-orange-500/5 space-y-2">
    <h2 class="font-bold text-orange-300 text-base">{g.tipTitle}</h2>
    <p class="text-sm text-zinc-300 leading-relaxed">{g.tipBody}</p>
  </aside>

  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-white tracking-tight">{g.faqTitle}</h2>
    <div class="space-y-3">
      {g.faqs.map((item) => (
        <details class="group rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
          <summary class="cursor-pointer font-semibold text-white text-sm list-none flex items-center justify-between gap-2">
            <span>{item.q}</span>
            <span class="text-orange-400 group-open:rotate-45 transition-transform text-base">+</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </div>

  <div class="pt-6 border-t border-zinc-800/80 space-y-4">
    <h2 class="text-lg font-bold text-white">{g.moreGuidesTitle}</h2>
    <div class="flex flex-wrap gap-2">
      {otherGuides.map((k) => (
        <a
          href={path(k, lang)}
          class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900 text-xs font-semibold text-zinc-300 hover:border-orange-500 hover:text-white transition-colors"
        >
          {guides[k][lang].navLabel}
        </a>
      ))}
    </div>
  </div>

  <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <h2 class="text-lg font-bold text-white">{d.ctaBand.title}</h2>
      <p class="text-sm text-zinc-400">{d.ctaBand.body}</p>
    </div>
    <a
      href={installUrl}
      class="inline-flex shrink-0 items-center justify-center px-5 py-2.5 rounded-xl bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400 transition-colors"
    >
      {d.nav.install}
    </a>
  </div>
</section>
