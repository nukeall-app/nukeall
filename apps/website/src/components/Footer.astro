---
import { BUYMEACOFFEE_URL, ISSUES_URL, RELEASES_URL, REPO_URL } from '../config';
import { GUIDE_KEYS, guides } from '../data/guides';
import { path, t, type Lang, type PageKey } from '../i18n/routes';

export interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const otherLang: Lang = lang === 'en' ? 'tr' : 'en';
const switchPath = page === 'notFound' ? path('home', otherLang) : path(page, otherLang);
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400 text-sm">
  <div class="max-w-6xl mx-auto px-4 py-12 grid gap-8 md:grid-cols-5">
    <div class="space-y-2 md:col-span-2">
      <div class="flex items-center gap-2 font-bold text-white text-base">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-orange-500 text-zinc-950 font-black text-xs">
          ☢
        </span>
        <span>NukeAll</span>
      </div>
      <p>{d.footer.tagline}</p>
      <p class="text-xs text-zinc-500">{d.footer.license}</p>
    </div>

    <div class="space-y-2">
      <div class="font-semibold text-zinc-200">{d.footer.guides}</div>
      <ul class="space-y-1.5 text-xs">
        {GUIDE_KEYS.map((k) => (
          <li><a href={path(k, lang)} class="hover:text-white">{guides[k][lang].navLabel}</a></li>
        ))}
      </ul>
    </div>

    <div class="space-y-2">
      <div class="font-semibold text-zinc-200">{d.footer.product}</div>
      <ul class="space-y-1.5 text-xs">
        <li><a href={path('install', lang)} class="hover:text-white">{d.nav.install}</a></li>
        <li><a href={path('compare', lang)} class="hover:text-white">{d.nav.compare}</a></li>
        <li><a href={path('faq', lang)} class="hover:text-white">{d.nav.faq}</a></li>
        <li><a href={path('privacy', lang)} class="hover:text-white">{d.nav.privacy}</a></li>
      </ul>
    </div>

    <div class="space-y-2">
      <div class="font-semibold text-zinc-200">{d.footer.project}</div>
      <ul class="space-y-1.5 text-xs">
        <li><a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white">{d.footer.source} ↗</a></li>
        <li><a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white">GitHub Releases ↗</a></li>
        <li><a href={BUYMEACOFFEE_URL} target="_blank" rel="noopener noreferrer" class="text-amber-300 hover:text-amber-200 font-medium">☕ Buy Me a Coffee ↗</a></li>
        <li><a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white">Issues ↗</a></li>
        <li>
          <a href={switchPath} hreflang={otherLang} class="text-orange-400 hover:underline">
            {d.footer.language}: {otherLang === 'tr' ? 'Türkçe' : 'English'}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-zinc-900 px-4 py-5 text-center text-xs text-zinc-500">
    {d.footer.disclaimer}
  </div>
</footer>
