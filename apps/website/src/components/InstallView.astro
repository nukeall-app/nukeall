---
import { AMO_LIVE, AMO_URL, RELEASES_URL } from '../config';
import { t, type Lang } from '../i18n/routes';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<div class="max-w-4xl mx-auto px-4 py-16 space-y-12">
  <header class="space-y-4">
    <h1 class="text-4xl font-extrabold text-white tracking-tight">{d.install.h1}</h1>
    <p class="text-lg text-zinc-400">{d.install.intro}</p>
    <div class="flex flex-wrap gap-2 pt-1">
      <a href="#firefox" class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/70 text-xs font-semibold text-zinc-200 hover:border-orange-500 transition-colors">
        🦊 {d.install.firefoxTitle}
      </a>
      <a href="#chromium" class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/70 text-xs font-semibold text-zinc-200 hover:border-orange-500 transition-colors">
        🌐 {d.install.chromeTitle}
      </a>
      <a href="#android" class="px-3 py-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-xs font-semibold text-emerald-300 hover:border-emerald-400 transition-colors">
        📱 {d.install.mobileAnchor}
      </a>
    </div>
  </header>

  <section id="firefox" class="p-6 md:p-8 rounded-2xl border border-zinc-800 bg-zinc-900/40 space-y-6">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <h2 class="text-2xl font-bold text-white">{d.install.firefoxTitle}</h2>
      {AMO_LIVE ? (
        <a
          href={AMO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400"
        >
          {d.install.openAmo} ↗
        </a>
      ) : (
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">
            {d.hero.soon}
          </span>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400"
          >
            {d.install.download} ↗
          </a>
        </div>
      )}
    </div>

    {AMO_LIVE ? (
      <>
        <div class="space-y-3">
          <h3 class="font-bold text-orange-400">{d.install.amoTitle}</h3>
          <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
            {d.install.amoSteps.map((step) => (
              <li set:html={step} />
            ))}
          </ol>
        </div>

        <div class="pt-4 border-t border-zinc-800 space-y-3">
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <h3 class="font-bold text-white">{d.install.tempTitle}</h3>
            <a
              href={RELEASES_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-orange-400 hover:underline"
            >
              {d.install.download} ↗
            </a>
          </div>
          <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
            {d.install.tempSteps.map((step) => (
              <li set:html={step} />
            ))}
          </ol>
        </div>
      </>
    ) : (
      <>
        <div class="space-y-3">
          <p class="text-xs text-amber-300/90">{d.install.amoSoon}</p>
          <h3 class="font-bold text-orange-400">{d.install.tempTitle}</h3>
          <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
            {d.install.tempSteps.map((step) => (
              <li set:html={step} />
            ))}
          </ol>
        </div>

        <div class="pt-4 border-t border-zinc-800 space-y-3 opacity-80">
          <h3 class="font-bold text-white">{d.install.amoTitle}</h3>
          <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-400">
            {d.install.amoSteps.map((step) => (
              <li set:html={step} />
            ))}
          </ol>
        </div>
      </>
    )}
  </section>

  <section id="chromium" class="p-6 md:p-8 rounded-2xl border border-zinc-800 bg-zinc-900/40 space-y-5">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <h2 class="text-2xl font-bold text-white">{d.install.chromeTitle}</h2>
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-lg bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400"
      >
        {d.install.download} ↗
      </a>
    </div>
    <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
      {d.install.chromeSteps.map((step) => (
        <li set:html={step} />
      ))}
    </ol>
    <p class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 text-xs text-zinc-400">
      {d.install.devNote}
    </p>
  </section>

  <section id="android" class="p-6 md:p-8 rounded-2xl border border-zinc-800 bg-zinc-900/40 space-y-6">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-3 flex-wrap">
        <h2 class="text-2xl font-bold text-white">📱 {d.install.mobileTitle}</h2>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          {d.install.mobileBadge}
        </span>
      </div>
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-lg bg-orange-500 text-zinc-950 font-bold text-sm hover:bg-orange-400"
      >
        {d.install.download} ↗
      </a>
    </div>

    <div class="space-y-3">
      <h3 class="font-bold text-orange-400">{d.install.mobileChromiumTitle}</h3>
      <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
        {d.install.mobileChromiumSteps.map((step) => (
          <li set:html={step} />
        ))}
      </ol>
    </div>

    <div class="pt-4 border-t border-zinc-800 space-y-2">
      <h3 class="font-bold text-white text-sm">{d.install.mobileFirefoxTitle}</h3>
      <p class="text-sm text-zinc-400 leading-relaxed" set:html={d.install.mobileFirefoxBody} />
    </div>

    <div class="p-4 rounded-xl bg-zinc-950 border border-amber-500/30 space-y-2">
      <div class="font-bold text-amber-300 text-xs uppercase tracking-wide">{d.install.mobileNoticeTitle}</div>
      <ul class="list-disc list-inside space-y-1.5 text-xs text-zinc-300 leading-relaxed">
        {d.install.mobileNoticeLines.map((line) => (
          <li set:html={line} />
        ))}
      </ul>
    </div>
  </section>

  <section class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/20 space-y-3">
    <h2 class="text-xl font-bold text-white">{d.install.afterTitle}</h2>
    <ol class="list-decimal list-inside space-y-2 text-sm text-zinc-300">
      {d.install.afterSteps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>
</div>
